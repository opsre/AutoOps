        <plugins>
            <!-- <plugin>
               <groupId>org.springframework.boot</groupId>
               <artifactId>spring-boot-maven-plugin</artifactId>
               <configuration>
                   <fork>true</fork>
                   <mainClass>com.jjshome.bigdata.DpfApplication</mainClass>
